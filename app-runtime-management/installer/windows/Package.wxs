<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="TimeOnChrome App Runtime"
           Manufacturer="TimeOnChrome"
           Version="1.0.0"
           UpgradeCode="B646BA2C-3D5F-45B3-8BAA-3277B42C33AD"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 TimeOnChrome App Runtime。" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="CompanyFolder" Name="TimeOnChrome">
        <Directory Id="INSTALLFOLDER" Name="AppRuntime">
          <Files Include="!(bindpath.TimeOnChrome.AppRuntime.Setup.exe)" />
          <Files Include="!(bindpath.TimeOnChrome.AppRuntime.Agent.exe)" />
          <Files Include="!(bindpath.*.dll)" />
          <Files Include="!(bindpath.*.json)" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="TimeOnChrome">
        <Component Id="StartMenuShortcut" Guid="5C93627C-7624-4F08-B892-A154DBCE06F3">
          <Shortcut Id="SetupShortcut" Name="电脑应用使用设置"
                    Target="[INSTALLFOLDER]TimeOnChrome.AppRuntime.Setup.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\TimeOnChrome\AppRuntime" Name="Installed"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="TimeOnChrome App Runtime" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="Files" />
    </Feature>
  </Package>
</Wix>
