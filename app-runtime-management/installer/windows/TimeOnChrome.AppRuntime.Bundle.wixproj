<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <OutputName>TimeOnChrome-AppRuntime-Setup-win-x64</OutputName>
    <OutputType>Bundle</OutputType>
    <ProductVersion Condition="'$(ProductVersion)' == ''">2.0.4</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
    <PackageOutputDir>$(MSBuildThisFileDirectory)bin\$(Configuration)</PackageOutputDir>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\win-x64</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <BindPath Include="$(PackageOutputDir)" BindName="Package" />
    <BindPath Include="$(PublishDir)" BindName="Publish" />
    <Compile Remove="Package.wxs" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
