<Window x:Class="TimeOnChrome.AppRuntime.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeOnChrome 电脑应用使用" Height="390" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <Grid Margin="36">
    <StackPanel>
      <TextBlock Text="连接这台 Windows 电脑" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Margin="0,12,0,22" TextWrapping="Wrap" Foreground="#5B6472"
                 Text="在家长控制台的“电脑应用使用”页面添加设备，然后在这里输入 12 位配对码。每个 Windows 用户需要单独配对。" />
      <TextBlock Text="配对码" FontWeight="SemiBold" />
      <TextBox x:Name="PairingCode" Margin="0,8,0,14" Height="42" FontSize="20"
               CharacterCasing="Upper" MaxLength="14" VerticalContentAlignment="Center" />
      <Button x:Name="ConnectButton" Content="连接" Height="44" Click="ConnectButton_Click" />
      <ProgressBar x:Name="Progress" Margin="0,16,0,0" Height="5" IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock x:Name="Status" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#5B6472"
                 Text="未连接：此状态下不会采集或上传应用使用数据。" />
    </StackPanel>
  </Grid>
</Window>
