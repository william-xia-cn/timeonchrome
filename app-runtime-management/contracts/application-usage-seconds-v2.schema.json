{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.app/contracts/application-usage-seconds-v2.schema.json",
  "title": "应用权威整数秒只读快照",
  "$ref": "#/$defs/snapshot",
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,159}$" },
    "seconds": { "type": "integer", "minimum": 0, "maximum": 604800 },
    "timestamp": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "reasons": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" } },
    "category": { "enum": ["study", "composite", "restrictedEntertainment", "unclassified", "other", "blocked", "historicalUnknown"] },
    "categories": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/category" },
      "additionalProperties": { "$ref": "#/$defs/seconds" }
    },
    "query": {
      "description": "最多七个北京时间日期；后续页携同一冻结revision。请求不得自报孩子／用户；范围由验证过的Service本地调用上下文决定。",
      "type": "object", "additionalProperties": false, "required": ["fromDate", "toDate", "offset"],
      "properties": {
        "fromDate": { "$ref": "#/$defs/date" }, "toDate": { "$ref": "#/$defs/date" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "expectedRevision": { "$ref": "#/$defs/revision" }
      },
      "allOf": [{ "if": { "properties": { "offset": { "minimum": 1 } } }, "then": { "required": ["expectedRevision"] } }]
    },
    "hour": {
      "type": "object", "additionalProperties": false, "required": ["hour", "totalSeconds", "categoriesSeconds"],
      "properties": {
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "totalSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "categoriesSeconds": { "$ref": "#/$defs/categories" }
      }
    },
    "day": {
      "description": "totalSeconds为该日有效已知量；范围不完整时不冒充完整量。pending_update不废弃已存在的冻结结果。",
      "type": "object", "additionalProperties": false,
      "required": ["date", "status", "generatedAtMs", "settledThroughMs", "complete", "reasonCodes", "totalSeconds", "categoriesSeconds", "hours"],
      "properties": {
        "date": { "$ref": "#/$defs/date" }, "status": { "enum": ["available", "pending_update", "incomplete", "unknown"] },
        "generatedAtMs": { "$ref": "#/$defs/timestamp" }, "settledThroughMs": { "$ref": "#/$defs/timestamp" },
        "complete": { "type": "boolean" }, "reasonCodes": { "$ref": "#/$defs/reasons" },
        "totalSeconds": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400 },
        "categoriesSeconds": { "$ref": "#/$defs/categories" },
        "hours": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/hour" } }
      }
    },
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name", "classifications", "totalSeconds", "knownTotalSeconds", "dailySeconds"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "classifications": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/category" } },
        "totalSeconds": { "type": ["integer", "null"], "minimum": 0, "maximum": 604800 },
        "knownTotalSeconds": { "$ref": "#/$defs/seconds" },
        "dailySeconds": { "type": "object", "minProperties": 1, "maxProperties": 7,
          "propertyNames": { "$ref": "#/$defs/date" },
          "additionalProperties": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400 } }
      }
    },
    "snapshot": {
      "description": "只传持久化冻结统计。日／小时／范围守恒由共同validator校验；分类和应用可重叠，不相加生成总量。Host消息仍最多256KiB。",
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "durationUnit", "fromDate", "toDate", "revision", "computedAtMs", "lastSettledAtMs", "complete", "reasonCodes", "totalSeconds", "knownTotalSeconds", "knownCategoriesSeconds", "days", "applications", "nextOffset"],
      "properties": {
        "schemaVersion": { "const": 2 }, "durationUnit": { "const": "seconds" },
        "fromDate": { "$ref": "#/$defs/date" }, "toDate": { "$ref": "#/$defs/date" }, "revision": { "$ref": "#/$defs/revision" },
        "computedAtMs": { "$ref": "#/$defs/timestamp" }, "lastSettledAtMs": { "$ref": "#/$defs/timestamp" },
        "complete": { "type": "boolean" }, "reasonCodes": { "$ref": "#/$defs/reasons" },
        "totalSeconds": { "type": ["integer", "null"], "minimum": 0, "maximum": 604800 },
        "knownTotalSeconds": { "$ref": "#/$defs/seconds" }, "knownCategoriesSeconds": { "$ref": "#/$defs/categories" },
        "days": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "$ref": "#/$defs/day" } },
        "applications": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/application" } },
        "nextOffset": { "type": ["integer", "null"], "minimum": 0, "maximum": 20000 }
      }
    }
  }
}
