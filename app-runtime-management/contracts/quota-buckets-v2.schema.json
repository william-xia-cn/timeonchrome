{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.app/contracts/quota-buckets-v2.schema.json",
  "title": "现行配额桶读取与交换契约",
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "label": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "source", "fromDate", "toDate", "scope"],
      "properties": {
        "schemaVersion": { "const": 2 }, "source": { "enum": ["web", "application"] },
        "fromDate": { "$ref": "#/$defs/date" }, "toDate": { "$ref": "#/$defs/date" },
        "scope": { "enum": ["all", "other"] }
      }
    },
    "buckets": {
      "type": "object", "additionalProperties": false, "required": ["study", "composite", "rest"],
      "properties": {
        "study": { "$ref": "#/$defs/integer" }, "composite": { "$ref": "#/$defs/integer" }, "rest": { "$ref": "#/$defs/integer" }
      }
    },
    "day": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "bucketsSeconds", "settledThroughMs", "complete", "reasonCodes"],
      "properties": {
        "date": { "$ref": "#/$defs/date" }, "bucketsSeconds": { "$ref": "#/$defs/buckets" },
        "settledThroughMs": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/integer" }] },
        "complete": { "type": "boolean" },
        "reasonCodes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/label" } }
      },
      "allOf": [{ "if": { "properties": { "complete": { "const": true } } }, "then": { "properties": { "reasonCodes": { "maxItems": 0 } } } }]
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "durationUnit", "source", "childId", "fromDate", "toDate", "readAtMs", "days"],
      "properties": {
        "schemaVersion": { "const": 2 }, "durationUnit": { "const": "seconds" }, "source": { "enum": ["web", "application"] },
        "childId": { "$ref": "#/$defs/label" }, "fromDate": { "$ref": "#/$defs/date" }, "toDate": { "$ref": "#/$defs/date" },
        "readAtMs": { "$ref": "#/$defs/integer" }, "days": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "$ref": "#/$defs/day" } }
      }
    },
    "exchange": {
      "type": "object", "additionalProperties": false, "required": ["fromDate", "toDate", "webUsage"],
      "properties": {
        "fromDate": { "$ref": "#/$defs/date" }, "toDate": { "$ref": "#/$defs/date" },
        "webUsage": { "anyOf": [{ "type": "null" }, { "allOf": [{ "$ref": "#/$defs/snapshot" }, { "properties": { "source": { "const": "web" } } }] }] }
      }
    }
  }
}
