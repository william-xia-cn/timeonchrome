{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.example/contracts/application-ledger-v3.schema.json",
  "title": "应用主使用原账v3：固定Child ID和整数秒（不含媒体辅助账）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "childId", "source", "application", "date", "startWallTimeMs", "endWallTimeMs", "startMonotonicTimeMs", "endMonotonicTimeMs", "clockEpochId", "durationSeconds", "channel", "endReason", "estimated"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "childId": { "$ref": "#/$defs/identifier" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["machineId", "localUserId", "runtimeSessionId", "assignmentVersion"],
      "properties": {
        "machineId": { "$ref": "#/$defs/identifier" },
        "localUserId": { "$ref": "#/$defs/identifier", "description": "来源属性，不透明ID，非SID、用户名或路径" },
        "runtimeSessionId": { "$ref": "#/$defs/identifier" },
        "assignmentVersion": { "$ref": "#/$defs/integer" }
      }
    },
    "application": {
      "type": "object", "additionalProperties": false, "required": ["platform", "runtimeIdentity"],
      "properties": { "platform": { "enum": ["windows", "macos"] }, "runtimeIdentity": { "$ref": "#/$defs/identifier" } }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "北京时间日期，段不得跨日" },
    "startWallTimeMs": { "$ref": "#/$defs/integer" },
    "endWallTimeMs": { "$ref": "#/$defs/integer" },
    "startMonotonicTimeMs": { "$ref": "#/$defs/integer" },
    "endMonotonicTimeMs": { "$ref": "#/$defs/integer" },
    "clockEpochId": { "$ref": "#/$defs/identifier" },
    "durationSeconds": { "type": "integer", "minimum": 0, "maximum": 180 },
    "channel": { "enum": ["active", "pipActive"] },
    "endReason": { "enum": ["applicationSwitch", "userIdle", "sessionUnavailable", "systemSleep", "periodicSnapshot", "stateCorrection", "pipEnded", "checkpointUnconfirmed", "serviceRecovery", "clockAdjustment", "assignmentChanged"] },
    "estimated": {
      "type": "object", "additionalProperties": false, "required": ["isEstimated", "reason", "cappedAtSeconds"],
      "properties": {
        "isEstimated": { "type": "boolean" },
        "reason": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "cappedAtSeconds": { "enum": [90, null] }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
