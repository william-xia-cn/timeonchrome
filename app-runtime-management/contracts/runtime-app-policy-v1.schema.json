{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.local/contracts/app-runtime/runtime-app-policy-v1.schema.json",
  "title": "TimeOnChrome App Runtime Child App Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "effectiveAtMs", "classifications", "quotas"],
  "properties": {
    "version": { "type": "integer", "minimum": 0 },
    "effectiveAtMs": { "type": ["integer", "null"], "minimum": 0 },
    "productIdentityProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "knowledgeVersion", "items"],
      "properties": {
        "version": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "knowledgeVersion": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "maxItems": 20000, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["platform", "runtimeIdentity", "associationKey", "productId", "canonicalName", "status", "reasonCode"],
          "properties": {
            "platform": { "enum": ["windows", "macos"] },
            "runtimeIdentity": { "type": "string", "minLength": 1, "maxLength": 256 },
            "associationKey": { "type": "string", "minLength": 1, "maxLength": 512 },
            "productId": { "type": ["string", "null"], "maxLength": 128 },
            "canonicalName": { "type": "string", "maxLength": 256 },
            "status": { "enum": ["confirmed", "associated", "unresolved", "conflict"] },
            "reasonCode": { "enum": ["APPROVED_PRODUCT", "VERIFIED_LEAF_ALIAS", "IDENTITY_UNRESOLVED", "IDENTITY_CONFLICT"] }
          }
        } }
      }
    },
    "productBlockPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "knowledgeVersion", "associationVersion", "entries"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "knowledgeVersion": { "type": "integer", "minimum": 0 },
        "associationVersion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "entries": { "type": "array", "maxItems": 1000, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["productId", "strongMatchers", "suspectedMatchers"],
          "properties": {
            "productId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "strongMatchers": { "type": "array", "maxItems": 64, "items": {
              "type": "object", "additionalProperties": false, "required": ["field", "value"],
              "properties": { "field": { "enum": ["packageId", "fileSeriesKey", "binaryHash"] }, "value": { "type": "string", "minLength": 1, "maxLength": 256 } }
            } },
            "suspectedMatchers": { "type": "array", "maxItems": 16, "items": {
              "type": "object", "additionalProperties": false, "required": ["signerKey", "productName"],
              "properties": { "signerKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "productName": { "type": "string", "minLength": 1, "maxLength": 256 } }
            } }
          }
        } }
      }
    },
    "repairWeekStart": { "const": "2026-09-21" },
    "weekReclassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromMs", "toMs", "applications"],
      "properties": {
        "fromMs": { "type": "integer", "minimum": 0 },
        "toMs": { "type": "integer", "minimum": 1 },
        "applications": {
          "type": "array", "maxItems": 12000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["platform", "runtimeIdentity", "classification"],
            "properties": {
              "platform": { "enum": ["windows", "macos"] },
              "runtimeIdentity": { "type": "string", "minLength": 1, "maxLength": 256 },
              "classification": { "enum": ["study", "composite", "restrictedEntertainment", "unclassified", "other", "blocked"] }
            }
          }
        }
      }
    },
    "classifications": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "runtimeIdentity", "displayName", "classification"],
        "properties": {
          "platform": { "enum": ["windows", "macos"] },
          "runtimeIdentity": { "type": "string", "minLength": 1, "maxLength": 256 },
          "displayName": { "type": ["string", "null"], "maxLength": 256 },
          "classification": { "enum": ["study", "composite", "restrictedEntertainment", "unclassified", "other", "blocked"] }
        }
      }
    },
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dailyCategoryMinutes", "weeklyRestrictedEntertainmentMinutes", "perApplicationDailyMinutes"],
      "properties": {
        "dailyCategoryMinutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["study", "composite", "restrictedEntertainment", "unclassified"],
          "properties": {
            "study": { "$ref": "#/$defs/quotaMinutes" },
            "composite": { "$ref": "#/$defs/quotaMinutes" },
            "restrictedEntertainment": { "$ref": "#/$defs/quotaMinutes" },
            "unclassified": { "$ref": "#/$defs/quotaMinutes" }
          }
        },
        "weeklyRestrictedEntertainmentMinutes": { "$ref": "#/$defs/quotaMinutes" },
        "perApplicationDailyMinutes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "runtimeIdentity", "minutes"],
            "properties": {
              "platform": { "enum": ["windows", "macos"] },
              "runtimeIdentity": { "type": "string", "minLength": 1, "maxLength": 256 },
              "minutes": { "$ref": "#/$defs/quotaMinutes" }
            }
          }
        }
      }
    },
    "timeWindows": {
      "$ref": "#/$defs/timeWindows"
    }
  },
  "$defs": {
    "quotaMinutes": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 10080
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        "end": { "type": "string", "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$" }
      }
    },
    "dailyWindows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study", "composite", "restrictedEntertainment", "unclassified"],
      "properties": {
        "study": { "type": "array", "items": { "$ref": "#/$defs/timeWindow" } },
        "composite": { "type": "array", "items": { "$ref": "#/$defs/timeWindow" } },
        "restrictedEntertainment": { "type": "array", "items": { "$ref": "#/$defs/timeWindow" } },
        "unclassified": { "type": "array", "items": { "$ref": "#/$defs/timeWindow" } }
      }
    },
    "timeWindows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
      "properties": {
        "monday": { "$ref": "#/$defs/dailyWindows" },
        "tuesday": { "$ref": "#/$defs/dailyWindows" },
        "wednesday": { "$ref": "#/$defs/dailyWindows" },
        "thursday": { "$ref": "#/$defs/dailyWindows" },
        "friday": { "$ref": "#/$defs/dailyWindows" },
        "saturday": { "$ref": "#/$defs/dailyWindows" },
        "sunday": { "$ref": "#/$defs/dailyWindows" }
      }
    }
  }
}
