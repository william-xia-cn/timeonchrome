{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.app/contracts/shared-web-sync-v1.schema.json",
  "title": "D-114 独立派生网页贡献、水位及专用来源证明",
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "ordinal": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "webKey": { "type": "string", "pattern": "^web:[a-f0-9]{64}$" },
    "reasonCodes": { "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "type": "string", "pattern": "^[A-Z0-9_]{1,64}$" } },
    "upload": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion","date","revisionOrdinal","statisticsRevision","correctionRevision","policyIdentity","computedAtMs","settledAtMs","activeMs","bucketsMs","otherMs","complete","reasonCodes","contentHash"],
      "properties": {
        "schemaVersion": { "const": 1 }, "date": { "$ref": "#/$defs/date" }, "revisionOrdinal": { "$ref": "#/$defs/ordinal" },
        "statisticsRevision": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "correctionRevision": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "policyIdentity": { "$ref": "shared-access-v1.schema.json#/$defs/policyIdentity" },
        "computedAtMs": { "$ref": "#/$defs/ms" }, "settledAtMs": { "anyOf": [{ "$ref": "#/$defs/ms" },{ "type": "null" }] },
        "activeMs": { "type": "integer", "minimum": 0, "maximum": 86400000, "multipleOf": 1000 },
        "bucketsMs": { "type": "object", "additionalProperties": false, "required": ["study","composite","rest"],
          "properties": { "study": { "type": "integer", "minimum": 0, "multipleOf": 1000 },
            "composite": { "type": "integer", "minimum": 0, "multipleOf": 1000 }, "rest": { "type": "integer", "minimum": 0, "multipleOf": 1000 } } },
        "otherMs": { "type": "integer", "minimum": 0, "multipleOf": 1000 }, "complete": { "type": "boolean" },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" }, "contentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion","audience","challengeId","connectionHash","applicationSourceKey","childScopeHash","assignmentVersion","webSourceKey","issuedAtMs","expiresAtMs"],
      "properties": {
        "schemaVersion": { "const": 1 }, "audience": { "const": "timeonchrome:shared-web-source:v1" },
        "challengeId": { "$ref": "#/$defs/hash" }, "connectionHash": { "$ref": "#/$defs/hash" },
        "applicationSourceKey": { "$ref": "#/$defs/hash" }, "childScopeHash": { "$ref": "#/$defs/hash" },
        "assignmentVersion": { "$ref": "#/$defs/ordinal" }, "webSourceKey": { "$ref": "#/$defs/webKey" },
        "issuedAtMs": { "$ref": "#/$defs/ms" }, "expiresAtMs": { "$ref": "#/$defs/ms" }
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion","keyId","claims","signature"],
      "properties": { "schemaVersion": { "const": 1 }, "keyId": { "$ref": "#/$defs/hash" },
        "claims": { "$ref": "#/$defs/claims" }, "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" } }
    },
    "watermark": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion","sourceKey","date","revisionOrdinal","contentHash","publicationRevision"],
      "properties": { "schemaVersion": { "const": 1 }, "sourceKey": { "$ref": "#/$defs/webKey" },
        "date": { "$ref": "#/$defs/date" }, "revisionOrdinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "contentHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "publicationRevision": { "anyOf": [{ "type": "string", "pattern": "^[1-9][0-9]*:[a-f0-9]{64}$" }, { "type": "null" }] } }
    },
    "challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion","challengeId","connectionHash","expiresAtMs"],
      "properties": { "schemaVersion": { "const": 1 }, "challengeId": { "$ref": "#/$defs/hash" },
        "connectionHash": { "$ref": "#/$defs/hash" }, "expiresAtMs": { "$ref": "#/$defs/ms" } }
    },
    "machineChallenge": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion","challengeId","connectionHash","expiresAtMs","applicationSourceKey","childScopeHash"],
      "properties": { "schemaVersion": { "const": 1 }, "challengeId": { "$ref": "#/$defs/hash" },
        "connectionHash": { "$ref": "#/$defs/hash" }, "expiresAtMs": { "$ref": "#/$defs/ms" },
        "applicationSourceKey": { "$ref": "#/$defs/hash" }, "childScopeHash": { "$ref": "#/$defs/hash" } }
    },
    "verificationKey": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion","keyId","publicJwk"],
      "properties": { "schemaVersion": { "const": 1 }, "keyId": { "$ref": "#/$defs/hash" },
        "publicJwk": { "type": "object", "additionalProperties": false, "required": ["kty","crv","x","y"],
          "properties": { "kty": { "const": "EC" }, "crv": { "const": "P-256" },
            "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }, "y": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" } } } }
    },
    "bindQuery": { "type": "object", "additionalProperties": false, "required": ["proof"],
      "properties": { "proof": { "$ref": "#/$defs/proof" } } },
    "replaceQuery": { "type": "object", "additionalProperties": false, "required": ["challengeId","upload"],
      "properties": { "challengeId": { "$ref": "#/$defs/hash" }, "upload": { "$ref": "#/$defs/upload" } } }
  }
}
