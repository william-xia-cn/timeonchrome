{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.app/contracts/shared-reminder-lifecycle-v1.schema.json",
  "title": "Service-issued shared reminder lifecycle",
  "$defs": {
    "key": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "time": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nullableTime": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
    "browserActivity": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "leaseId", "activityId", "sequence", "status", "quotaBucket", "presentationEligible"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "leaseId": { "$ref": "#/$defs/key" },
        "activityId": { "$ref": "#/$defs/key" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "status": { "enum": ["active", "inactive"] },
        "quotaBucket": { "enum": ["rest", null] },
        "presentationEligible": { "type": "boolean" }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
        "then": { "properties": { "quotaBucket": { "const": "rest" } } },
        "else": { "properties": { "quotaBucket": { "type": "null" }, "presentationEligible": { "const": false } } }
      }]
    },
    "deliveryAck": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "roundId", "reminderId", "deliveryId", "policyRevision", "stateRevision", "delivery"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "roundId": { "$ref": "#/$defs/key" },
        "reminderId": { "$ref": "#/$defs/key" },
        "deliveryId": { "$ref": "#/$defs/key" },
        "policyRevision": { "$ref": "#/$defs/key" },
        "stateRevision": { "$ref": "#/$defs/key" },
        "delivery": { "enum": ["visible", "failed"] }
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "roundId", "reminderId", "deliveryId", "policyRevision", "stateRevision", "action"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "roundId": { "$ref": "#/$defs/key" },
        "reminderId": { "$ref": "#/$defs/key" },
        "deliveryId": { "$ref": "#/$defs/key" },
        "policyRevision": { "$ref": "#/$defs/key" },
        "stateRevision": { "$ref": "#/$defs/key" },
        "action": { "enum": ["continue", "end_rest"] }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "roundId", "reminderId", "deliveryId", "policyRevision", "stateRevision", "date", "kinds", "presenter", "stage", "issuedAtMs", "offerExpiresAtMs", "visibleAtMs", "responseDeadlineSeconds", "timeoutAction", "status", "resolution"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "roundId": { "$ref": "#/$defs/key" },
        "reminderId": { "$ref": "#/$defs/key" },
        "deliveryId": { "$ref": "#/$defs/key" },
        "policyRevision": { "$ref": "#/$defs/key" },
        "stateRevision": { "$ref": "#/$defs/key" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "kinds": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["entry", "daily", "weekly"] } },
        "presenter": { "enum": ["browser", "native"] },
        "stage": { "enum": ["shadow", "shared"] },
        "issuedAtMs": { "$ref": "#/$defs/time" },
        "offerExpiresAtMs": { "$ref": "#/$defs/time" },
        "visibleAtMs": { "$ref": "#/$defs/nullableTime" },
        "responseDeadlineSeconds": { "const": 60 },
        "timeoutAction": { "enum": ["continue", "end"] },
        "status": { "enum": ["offered", "visible", "delivery_failed", "resolved", "withdrawn"] },
        "resolution": { "enum": ["continue", "end_rest", "timeout_continue", "timeout_end", null] }
      }
    }
  }
}
