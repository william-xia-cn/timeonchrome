{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-application-identification-v1.schema.json",
  "title": "本机应用命名上传与回执，不是产品权限",
  "$ref": "#/$defs/batch",
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["nativeId", "name", "status", "evidence"],
      "properties": {
        "nativeId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9_.:-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "allOf": [
          { "pattern": "\\S" }, { "not": { "pattern": "^(?:[a-zA-Z]:[\\\\/]|\\\\\\\\|[fF][iI][lL][eE]://)" } }
        ] },
        "status": { "enum": ["identified", "dynamic-registry", "dynamic-process"] },
        "evidence": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "enum": [
          "explicit-window-aumid", "os-application-aumid", "dedicated-known-image-path",
          "image-and-script-argument", "image-and-app-id", "host-image-and-app-id", "image-and-launch-mode",
          "browser-image-with-app-mode-guard", "launch-image-path", "steam-launch-app-id",
          "STATIC_IDENTITY_CONFLICT", "STATIC_LAUNCH_IDENTITY_ONLY", "REGISTRY_INSTALL_DIRECTORY_CANDIDATE",
          "REGISTRY_SOURCE_INCOMPLETE", "REGISTRY_DIRECTORY_AMBIGUOUS", "REGISTRY_CATALOG_UNAVAILABLE", "PROCESS_NAME_FALLBACK"
        ] } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "identified" } } },
          "then": { "properties": { "nativeId": { "not": { "pattern": "^dynamic-local:" } } } },
          "else": { "anyOf": [
            { "properties": { "nativeId": { "pattern": "^dynamic-local:" } } },
            { "properties": { "nativeId": { "pattern": "^macos:[a-f0-9]{64}$" }, "status": { "const": "dynamic-process" } } }
          ] } }
      ]
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["instanceId", "revision", "observedAtMs", "identifications"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/hash" }, "revision": { "$ref": "#/$defs/revision" },
        "observedAtMs": { "type": "integer", "minimum": 0, "maximum": 253402271999999 },
        "identifications": { "oneOf": [ { "type": "null" }, { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/identity" } } ] }
      }
    },
    "batch": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "childId", "localUserId", "assignmentVersion", "items"],
      "properties": {
        "schemaVersion": { "const": 1 }, "childId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "localUserId": { "type": "string", "minLength": 1, "maxLength": 256 }, "assignmentVersion": { "$ref": "#/$defs/revision" },
        "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "childId", "localUserId", "assignmentVersion", "items"],
      "properties": {
        "schemaVersion": { "const": 1 }, "childId": { "type": "string" }, "localUserId": { "type": "string" },
        "assignmentVersion": { "$ref": "#/$defs/revision" },
        "items": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false,
          "required": ["instanceId", "revision", "payloadHash"], "properties": {
            "instanceId": { "$ref": "#/$defs/hash" }, "revision": { "$ref": "#/$defs/revision" }, "payloadHash": { "$ref": "#/$defs/hash" }
          } } }
      }
    }
  }
}
