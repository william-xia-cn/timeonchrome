{
  "name": "@timeonchrome/app-runtime-contracts",
  "version": "1.47.0",
  "private": false,
  "type": "module",
  "exports": {
    "./source-statistics": {
      "types": "./dist/source-statistics.d.ts",
      "default": "./dist/source-statistics.js"
    },
    "./application-usage-seconds": {
      "types": "./dist/application-usage-seconds.d.ts",
      "default": "./dist/application-usage-seconds.js"
    },
    "./application-ledger": {
      "types": "./dist/application-ledger.d.ts",
      "default": "./dist/application-ledger.js"
    },
    "./shared-web-sync": {
      "types": "./dist/shared-web-sync.d.ts",
      "default": "./dist/shared-web-sync.js"
    },
    "./shared-quota-execution": {
      "types": "./dist/shared-quota-execution.d.ts",
      "default": "./dist/shared-quota-execution.js"
    },
    "./shared-reminder-lifecycle": {
      "types": "./dist/shared-reminder-lifecycle.d.ts",
      "default": "./dist/shared-reminder-lifecycle.js"
    },
    "./shared-access": {
      "types": "./dist/shared-access.d.ts",
      "default": "./dist/shared-access.js"
    },
    "./usage-account": {
      "types": "./dist/usage-account.d.ts",
      "default": "./dist/usage-account.js"
    },
    "./computer-usage": {
      "types": "./dist/computer-usage.d.ts",
      "default": "./dist/computer-usage.js"
    },
    "./classification-validation": {
      "types": "./dist/application-knowledge-validation.d.ts",
      "default": "./dist/application-knowledge-validation.js"
    },
    "./classification": {
      "types": "./dist/application-classification.d.ts",
      "default": "./dist/application-classification.js"
    },
    "./native-host": {
      "types": "./dist/native-host.d.ts",
      "default": "./dist/native-host.js"
    },
    ".": {
      "types": "./dist/app-runtime-control.d.ts",
      "default": "./dist/app-runtime-control.js"
    }
  },
  "files": [
    "source-statistics.ts",
    "application-usage-seconds.ts",
    "application-ledger.ts",
    "shared-web-sync.ts",
    "shared-quota-execution.ts",
    "shared-reminder-lifecycle.ts",
    "app-runtime-control.ts",
    "computer-usage.ts",
    "usage-account.ts",
    "shared-access.ts",
    "application-classification.ts",
    "application-knowledge-validation.ts",
    "*.schema.json",
    "*.vectors.json",
    "dist"
  ],
  "scripts": {
    "test:source-statistics": "node source-statistics.test.mjs",
    "test:application-usage-seconds": "node application-usage-seconds.test.mjs",
    "test:application-ledger": "node application-ledger.test.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node contract-compatibility.test.cjs && node source-statistics.test.mjs && node application-usage-seconds.test.mjs && node classification.test.mjs && node machine-control.test.mjs && node computer-usage.test.mjs && node usage-account.test.mjs && node shared-access.test.mjs && node shared-quota-execution.test.mjs && node shared-reminder-lifecycle.test.mjs && node shared-web-sync.test.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
