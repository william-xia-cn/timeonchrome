{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.app/contracts/shared-reminder-lifecycle-v2.schema.json",
  "title": "当前V2提醒生命周期与浏览器执行契约",
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nullableTime": {
      "anyOf": [
        {
          "$ref": "#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "browserActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "leaseId",
        "activityId",
        "sequence",
        "status",
        "quotaBucket",
        "presentationEligible",
        "policyIdentity",
        "ruleScopeKey",
        "reasonCodes",
        "independentRoundId"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "leaseId": {
          "$ref": "#/$defs/key"
        },
        "activityId": {
          "$ref": "#/$defs/key"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "active",
            "pending-entry",
            "inactive"
          ]
        },
        "quotaBucket": {
          "enum": [
            "study",
            "composite",
            "rest",
            "other",
            null
          ]
        },
        "presentationEligible": {
          "type": "boolean"
        },
        "policyIdentity": {
          "$ref": "#/$defs/policyIdentity"
        },
        "ruleScopeKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/ruleScopeKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCodes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "independentRoundId": {
          "anyOf": [
            {
              "$ref": "#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "active",
                  "pending-entry"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "quotaBucket": {
                "enum": [
                  "study",
                  "composite",
                  "rest",
                  "other"
                ]
              },
              "ruleScopeKey": {
                "$ref": "#/$defs/ruleScopeKey"
              }
            }
          },
          "else": {
            "properties": {
              "quotaBucket": {
                "type": "null"
              },
              "ruleScopeKey": {
                "type": "null"
              },
              "presentationEligible": {
                "const": false
              },
              "reasonCodes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending-entry"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCodes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "browserExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "roundId",
        "reminderId",
        "deliveryId",
        "policyRevision",
        "stateRevision",
        "executionId",
        "leaseId",
        "activityId",
        "targetSource",
        "effect",
        "maxAgeMs",
        "policyIdentity"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "roundId": {
          "$ref": "#/$defs/key"
        },
        "reminderId": {
          "$ref": "#/$defs/key"
        },
        "deliveryId": {
          "$ref": "#/$defs/key"
        },
        "policyRevision": {
          "$ref": "#/$defs/key"
        },
        "stateRevision": {
          "$ref": "#/$defs/key"
        },
        "executionId": {
          "$ref": "#/$defs/key"
        },
        "leaseId": {
          "$ref": "#/$defs/key"
        },
        "activityId": {
          "$ref": "#/$defs/key"
        },
        "targetSource": {
          "const": "browser"
        },
        "effect": {
          "enum": [
            "request-normal-close",
            "force-close"
          ]
        },
        "maxAgeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "policyIdentity": {
          "$ref": "#/$defs/policyIdentity"
        }
      }
    },
    "browserExecutionAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "roundId",
        "reminderId",
        "deliveryId",
        "policyRevision",
        "stateRevision",
        "executionId",
        "leaseId",
        "activityId",
        "outcome",
        "policyIdentity"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "roundId": {
          "$ref": "#/$defs/key"
        },
        "reminderId": {
          "$ref": "#/$defs/key"
        },
        "deliveryId": {
          "$ref": "#/$defs/key"
        },
        "policyRevision": {
          "$ref": "#/$defs/key"
        },
        "stateRevision": {
          "$ref": "#/$defs/key"
        },
        "executionId": {
          "$ref": "#/$defs/key"
        },
        "leaseId": {
          "$ref": "#/$defs/key"
        },
        "activityId": {
          "$ref": "#/$defs/key"
        },
        "outcome": {
          "enum": [
            "completed",
            "canceled",
            "failed",
            "stale"
          ]
        },
        "policyIdentity": {
          "$ref": "#/$defs/policyIdentity"
        }
      }
    },
    "deliveryAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "roundId",
        "reminderId",
        "deliveryId",
        "policyRevision",
        "stateRevision",
        "delivery"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "roundId": {
          "$ref": "#/$defs/key"
        },
        "reminderId": {
          "$ref": "#/$defs/key"
        },
        "deliveryId": {
          "$ref": "#/$defs/key"
        },
        "policyRevision": {
          "$ref": "#/$defs/key"
        },
        "stateRevision": {
          "$ref": "#/$defs/key"
        },
        "delivery": {
          "enum": [
            "visible",
            "failed"
          ]
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "roundId",
        "reminderId",
        "deliveryId",
        "policyRevision",
        "stateRevision",
        "action"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "roundId": {
          "$ref": "#/$defs/key"
        },
        "reminderId": {
          "$ref": "#/$defs/key"
        },
        "deliveryId": {
          "$ref": "#/$defs/key"
        },
        "policyRevision": {
          "$ref": "#/$defs/key"
        },
        "stateRevision": {
          "$ref": "#/$defs/key"
        },
        "action": {
          "enum": [
            "continue",
            "end_rest"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "roundId",
        "reminderId",
        "deliveryId",
        "policyRevision",
        "stateRevision",
        "date",
        "kinds",
        "presenter",
        "stage",
        "issuedAtMs",
        "offerExpiresAtMs",
        "visibleAtMs",
        "responseDeadlineSeconds",
        "timeoutAction",
        "status",
        "resolution",
        "policyIdentity",
        "ruleScopeKey",
        "reasonCodes",
        "forcedUsageSeconds",
        "confirmedAtUsageSeconds"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "roundId": {
          "$ref": "#/$defs/key"
        },
        "reminderId": {
          "$ref": "#/$defs/key"
        },
        "deliveryId": {
          "$ref": "#/$defs/key"
        },
        "policyRevision": {
          "$ref": "#/$defs/key"
        },
        "stateRevision": {
          "$ref": "#/$defs/key"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "entry",
              "repeat"
            ]
          }
        },
        "presenter": {
          "enum": [
            "browser",
            "native"
          ]
        },
        "stage": {
          "enum": [
            "shadow",
            "shared"
          ]
        },
        "issuedAtMs": {
          "$ref": "#/$defs/time"
        },
        "offerExpiresAtMs": {
          "$ref": "#/$defs/time"
        },
        "visibleAtMs": {
          "$ref": "#/$defs/nullableTime"
        },
        "responseDeadlineSeconds": {
          "const": 60
        },
        "timeoutAction": {
          "const": "end"
        },
        "status": {
          "enum": [
            "offered",
            "visible",
            "delivery_failed",
            "resolved",
            "withdrawn"
          ]
        },
        "resolution": {
          "enum": [
            "continue",
            "end_rest",
            "timeout_end",
            null
          ]
        },
        "policyIdentity": {
          "$ref": "#/$defs/policyIdentity"
        },
        "ruleScopeKey": {
          "$ref": "#/$defs/ruleScopeKey"
        },
        "reasonCodes": {
          "allOf": [
            {
              "$ref": "#/$defs/reasonCodes"
            },
            {
              "minItems": 1
            }
          ]
        },
        "forcedUsageSeconds": {
          "$ref": "#/$defs/time"
        },
        "confirmedAtUsageSeconds": {
          "$ref": "#/$defs/nullableTime"
        }
      }
    },
    "policyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "revision",
        "effectiveAtMs",
        "stage",
        "policyHash"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "revision": {
          "type": "string",
          "pattern": "^profile-config:(?:0|[1-9][0-9]*)$"
        },
        "effectiveAtMs": {
          "$ref": "#/$defs/time"
        },
        "stage": {
          "enum": [
            "legacy",
            "shadow",
            "shared"
          ]
        },
        "policyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "restrictedEntry",
          "dailyStudy",
          "dailyComposite",
          "dailyRest",
          "dailyOnline",
          "weeklyRest",
          "domain",
          "timeWindow"
        ]
      }
    },
    "ruleScopeKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stateQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "date"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
