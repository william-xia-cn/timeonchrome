{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://timeonchrome.app/contracts/source-statistics-v1.schema.json",
  "title":"分域整数秒统计只读契约",
  "$defs":{
    "date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "seconds":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
    "sourceKeys":{"type":"array","maxItems":200,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},
    "query":{
      "type":"object","additionalProperties":false,"required":["source","fromDate","toDate","scope"],
      "properties":{"source":{"enum":["web","application"]},"fromDate":{"$ref":"#/$defs/date"},"toDate":{"$ref":"#/$defs/date"},
        "scope":{"enum":["all","other"]},"ownSourceKeys":{"$ref":"#/$defs/sourceKeys"}},
      "allOf":[{"if":{"properties":{"scope":{"const":"all"}}},"then":{"not":{"required":["ownSourceKeys"]}}},
        {"if":{"properties":{"scope":{"const":"other"},"source":{"const":"application"}}},
         "then":{"required":["ownSourceKeys"],"properties":{"ownSourceKeys":{"minItems":1}}}}]
    },
    "day":{
      "type":"object","additionalProperties":false,
      "required":["date","totalSeconds","categoriesSeconds","settledThroughMs","complete","reasonCodes"],
      "properties":{"date":{"$ref":"#/$defs/date"},"totalSeconds":{"$ref":"#/$defs/seconds"},
        "nonSpecialTotalSeconds":{"$ref":"#/$defs/seconds"},"settledThroughMs":{"$ref":"#/$defs/seconds"},
        "categoriesSeconds":{"type":"object","maxProperties":16,"additionalProperties":{"type":"integer","minimum":0,"maximum":9007199254740991}},
        "complete":{"type":"boolean"},"reasonCodes":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}}}
    },
    "snapshot":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","durationUnit","source","childId","fromDate","toDate","revision","readAtMs","includedSourceKeys","excludedSourceKeys","days"],
      "properties":{"schemaVersion":{"const":1},"durationUnit":{"const":"seconds"},"source":{"enum":["web","application"]},
        "childId":{"type":"string","minLength":1,"maxLength":200},"fromDate":{"$ref":"#/$defs/date"},"toDate":{"$ref":"#/$defs/date"},
        "revision":{"type":"string","minLength":1,"maxLength":200},"readAtMs":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "includedSourceKeys":{"$ref":"#/$defs/sourceKeys"},"excludedSourceKeys":{"$ref":"#/$defs/sourceKeys"},
        "days":{"type":"array","minItems":1,"maxItems":7,"items":{"$ref":"#/$defs/day"}}},
      "allOf":[{"if":{"properties":{"source":{"const":"application"}}},
        "then":{"properties":{"days":{"items":{"required":["nonSpecialTotalSeconds"]}}}},
        "else":{"properties":{"days":{"items":{"not":{"required":["nonSpecialTotalSeconds"]}}}}}}]
    },
    "exchange":{
      "type":"object","additionalProperties":false,"required":["fromDate","toDate","webStatistics"],
      "properties":{"fromDate":{"$ref":"#/$defs/date"},"toDate":{"$ref":"#/$defs/date"},
        "webStatistics":{"anyOf":[{"type":"null"},{"allOf":[{"$ref":"#/$defs/snapshot"},{"properties":{"source":{"const":"web"}}}]}]}}
    }
  }
}
