{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.app/contracts/shared-access-v1.schema.json",
  "title": "Guardian-owned Child shared access contract",
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "milliseconds": { "type": "integer", "minimum": 0 },
    "minutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 10080 },
    "buckets": {
      "type": "object", "additionalProperties": false,
      "required": ["study", "composite", "rest"],
      "properties": {
        "study": { "$ref": "#/$defs/milliseconds" },
        "composite": { "$ref": "#/$defs/milliseconds" },
        "rest": { "$ref": "#/$defs/milliseconds" }
      }
    },
    "window": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$" }
      }
    },
    "dayMinutes": {
      "type": "object", "additionalProperties": false, "required": ["study", "composite", "rest"],
      "properties": {
        "study": { "$ref": "#/$defs/minutes" },
        "composite": { "$ref": "#/$defs/minutes" },
        "rest": { "$ref": "#/$defs/minutes" }
      }
    },
    "dayWindows": {
      "type": "object", "additionalProperties": false, "required": ["study", "composite", "rest"],
      "properties": {
        "study": { "type": ["array", "null"], "items": { "$ref": "#/$defs/window" } },
        "composite": { "type": ["array", "null"], "items": { "$ref": "#/$defs/window" } },
        "rest": { "type": ["array", "null"], "items": { "$ref": "#/$defs/window" } }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "revision", "effectiveAtMs", "stage", "dailyMinutes", "weeklyRestMinutes", "timeWindows", "autonomy"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "effectiveAtMs": { "$ref": "#/$defs/milliseconds" },
        "stage": { "enum": ["legacy", "shadow", "shared"] },
        "dailyMinutes": { "type": "object", "additionalProperties": false,
          "required": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
          "properties": {
            "monday": { "$ref": "#/$defs/dayMinutes" }, "tuesday": { "$ref": "#/$defs/dayMinutes" },
            "wednesday": { "$ref": "#/$defs/dayMinutes" }, "thursday": { "$ref": "#/$defs/dayMinutes" },
            "friday": { "$ref": "#/$defs/dayMinutes" }, "saturday": { "$ref": "#/$defs/dayMinutes" },
            "sunday": { "$ref": "#/$defs/dayMinutes" }
          } },
        "weeklyRestMinutes": { "$ref": "#/$defs/minutes" },
        "timeWindows": { "type": "object", "additionalProperties": false,
          "required": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
          "properties": {
            "monday": { "$ref": "#/$defs/dayWindows" }, "tuesday": { "$ref": "#/$defs/dayWindows" },
            "wednesday": { "$ref": "#/$defs/dayWindows" }, "thursday": { "$ref": "#/$defs/dayWindows" },
            "friday": { "$ref": "#/$defs/dayWindows" }, "saturday": { "$ref": "#/$defs/dayWindows" },
            "sunday": { "$ref": "#/$defs/dayWindows" }
          } },
        "autonomy": {
          "type": "object", "additionalProperties": false,
          "required": ["restrictedEntryConfirmationRequired", "dailyFirstReminderMinutes", "weeklyFirstReminderMinutes", "repeatReminderMinutes", "softReminderTimeoutAction", "visibleResponseDeadlineSeconds"],
          "properties": {
            "restrictedEntryConfirmationRequired": { "type": "boolean" },
            "dailyFirstReminderMinutes": { "$ref": "#/$defs/minutes" },
            "weeklyFirstReminderMinutes": { "$ref": "#/$defs/minutes" },
            "repeatReminderMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
            "softReminderTimeoutAction": { "enum": ["continue", "end_rest"] },
            "visibleResponseDeadlineSeconds": { "const": 60 }
          }
        }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "policyRevision", "revision", "computedAtMs", "settledAtMs", "complete", "reasonCodes", "sources", "day", "week", "offline"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "policyRevision": { "$ref": "#/$defs/revision" },
        "revision": { "$ref": "#/$defs/revision" },
        "computedAtMs": { "$ref": "#/$defs/milliseconds" },
        "settledAtMs": { "anyOf": [{ "$ref": "#/$defs/milliseconds" }, { "type": "null" }] },
        "complete": { "type": "boolean" },
        "reasonCodes": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 64 } },
        "sources": { "type": "array", "items": { "type": "object", "additionalProperties": false,
          "required": ["source", "sourceKey", "date", "revision"],
          "properties": {
            "source": { "enum": ["web", "application"] },
            "sourceKey": { "type": "string", "minLength": 1, "maxLength": 128 },
            "date": { "$ref": "#/$defs/date" },
            "revision": { "$ref": "#/$defs/revision" }
          } } },
        "day": { "type": "object", "additionalProperties": false,
          "required": ["date", "usedMs", "remainingMs", "borrowedRestMs"],
          "properties": {
            "date": { "$ref": "#/$defs/date" },
            "usedMs": { "$ref": "#/$defs/buckets" },
            "remainingMs": { "type": "object", "additionalProperties": false,
              "required": ["study", "composite", "rest"],
              "properties": {
                "study": { "anyOf": [{ "$ref": "#/$defs/milliseconds" }, { "type": "null" }] },
                "composite": { "anyOf": [{ "$ref": "#/$defs/milliseconds" }, { "type": "null" }] },
                "rest": { "anyOf": [{ "$ref": "#/$defs/milliseconds" }, { "type": "null" }] }
              } },
            "borrowedRestMs": { "$ref": "#/$defs/milliseconds" }
          } },
        "week": { "type": "object", "additionalProperties": false,
          "required": ["fromDate", "restUsedMs", "restRemainingMs"],
          "properties": {
            "fromDate": { "$ref": "#/$defs/date" },
            "restUsedMs": { "$ref": "#/$defs/milliseconds" },
            "restRemainingMs": { "anyOf": [{ "$ref": "#/$defs/milliseconds" }, { "type": "null" }] }
          } },
        "offline": { "type": "boolean" }
      }
    },
    "reminderResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "reminderId", "policyRevision", "stateRevision", "kind", "delivery", "visibleAtMs", "action", "resolvedAtMs"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "reminderId": { "$ref": "#/$defs/revision" },
        "policyRevision": { "$ref": "#/$defs/revision" },
        "stateRevision": { "$ref": "#/$defs/revision" },
        "kind": { "enum": ["entry", "daily", "weekly"] },
        "delivery": { "enum": ["visible", "failed"] },
        "visibleAtMs": { "anyOf": [{ "$ref": "#/$defs/milliseconds" }, { "type": "null" }] },
        "action": { "enum": ["continue", "end_rest", "timeout_continue", "timeout_end", "delivery_failed_continue", "delivery_failed_end"] },
        "resolvedAtMs": { "$ref": "#/$defs/milliseconds" }
      }
    },
    "contribution": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "source", "sourceKey", "date", "revision", "statisticsRevision", "correctionRevision", "policyRevision", "settledAtMs", "complete", "reasonCodes", "bucketsMs"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "source": { "enum": ["web", "application"] },
        "sourceKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "$ref": "#/$defs/date" },
        "revision": { "$ref": "#/$defs/revision" },
        "statisticsRevision": { "$ref": "#/$defs/revision" },
        "correctionRevision": { "$ref": "#/$defs/revision" },
        "productAssociationVersion": { "$ref": "#/$defs/revision" },
        "policyRevision": { "$ref": "#/$defs/revision" },
        "settledAtMs": { "anyOf": [{ "$ref": "#/$defs/milliseconds" }, { "type": "null" }] },
        "complete": { "type": "boolean" },
        "reasonCodes": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 64 } },
        "bucketsMs": { "$ref": "#/$defs/buckets" },
        "applicationClassesMs": {
          "type": "object", "additionalProperties": false,
          "required": ["study", "composite", "restrictedEntertainment", "unclassified", "other"],
          "properties": {
            "study": { "$ref": "#/$defs/milliseconds" },
            "composite": { "$ref": "#/$defs/milliseconds" },
            "restrictedEntertainment": { "$ref": "#/$defs/milliseconds" },
            "unclassified": { "$ref": "#/$defs/milliseconds" },
            "other": { "$ref": "#/$defs/milliseconds" }
          }
        },
        "chromeExcludedMs": { "$ref": "#/$defs/milliseconds" },
        "chromeIncludedInApplicationMs": { "anyOf": [{ "$ref": "#/$defs/milliseconds" }, { "type": "null" }] }
      },
      "allOf": [{
        "if": { "properties": { "source": { "const": "application" } }, "required": ["source"] },
        "then": { "required": ["applicationClassesMs", "chromeExcludedMs", "productAssociationVersion"] }
      }]
    },
    "applicationUpload": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "localUserId", "assignmentVersion", "revisionOrdinal", "contribution"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "localUserId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "assignmentVersion": { "type": "integer", "minimum": 1 },
        "revisionOrdinal": { "type": "integer", "minimum": 1 },
        "contribution": {
          "type": "object", "additionalProperties": false,
          "required": ["schemaVersion", "source", "date", "revision", "statisticsRevision", "correctionRevision",
            "productAssociationVersion", "policyRevision", "settledAtMs", "complete", "reasonCodes", "bucketsMs",
            "applicationClassesMs", "chromeExcludedMs", "chromeIncludedInApplicationMs"],
          "properties": {
            "schemaVersion": { "const": 1 },
            "source": { "const": "application" },
            "date": { "$ref": "#/$defs/date" },
            "revision": { "$ref": "#/$defs/revision" },
            "statisticsRevision": { "$ref": "#/$defs/revision" },
            "correctionRevision": { "$ref": "#/$defs/revision" },
            "productAssociationVersion": { "$ref": "#/$defs/revision" },
            "policyRevision": { "$ref": "#/$defs/revision" },
            "settledAtMs": { "anyOf": [{ "$ref": "#/$defs/milliseconds" }, { "type": "null" }] },
            "complete": { "type": "boolean" },
            "reasonCodes": { "$ref": "#/$defs/contribution/properties/reasonCodes" },
            "bucketsMs": { "$ref": "#/$defs/buckets" },
            "applicationClassesMs": { "$ref": "#/$defs/contribution/properties/applicationClassesMs" },
            "chromeExcludedMs": { "$ref": "#/$defs/milliseconds" },
            "chromeIncludedInApplicationMs": { "$ref": "#/$defs/contribution/properties/chromeIncludedInApplicationMs" }
          }
        }
      }
    }
  }
}
