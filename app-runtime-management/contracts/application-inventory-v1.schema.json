{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.invalid/contracts/application-inventory-v1",
  "title": "应用清单与可选盘点完整性摘要",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "observations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "batchId": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,128}$"},
    "observations": {"type":"array","maxItems":200,"items":{"$ref":"#/$defs/observation"}},
    "scan": {"$ref":"#/$defs/scan"}
  },
  "$defs": {
    "text": {"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f]+$"},
    "discovery": {
      "type":"object","additionalProperties":false,"required":["role","nameSource","sourceKinds"],
      "properties": {
        "role":{"enum":["application","component","candidate"]},
        "nameSource":{"enum":["appList","manifest","fileMetadata","installation","fallback"]},
        "sourceKinds":{"type":"array","maxItems":4,"uniqueItems":true,"items":{"enum":["package","registry","shortcut","runtime"]}},
        "applicationOrigin":{"enum":["user","operatingSystem","unknown"]},
        "originEvidenceCode":{"enum":["exactPackageRule","osMetadata","reviewedSystemBinary"]}
      }
    },
    "evidence": {
      "type":"object","additionalProperties":false,"required":["platform","runtimeIdentity","displayName","values","verifiedFields"],
      "properties": {
        "platform":{"enum":["windows","macos"]},"runtimeIdentity":{"$ref":"#/$defs/text"},"displayName":{"$ref":"#/$defs/text"},
        "values":{"type":"object","additionalProperties":false,"properties":{
          "runtimeIdentity":{"$ref":"#/$defs/text"},"binaryHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "packageId":{"$ref":"#/$defs/text"},"signerKey":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "productName":{"$ref":"#/$defs/text"},"declaredType":{"$ref":"#/$defs/text"},"installationSource":{"$ref":"#/$defs/text"}
        }},
        "verifiedFields":{"type":"array","maxItems":7,"uniqueItems":true,"items":{"enum":["runtimeIdentity","binaryHash","packageId","signerKey","productName","declaredType","installationSource"]}},
        "discovery":{"$ref":"#/$defs/discovery"}
      }
    },
    "observation": {
      "type":"object","additionalProperties":false,"required":["localUserId","evidence","status"],
      "properties":{"localUserId":{"type":"string","minLength":1,"maxLength":128},"evidence":{"$ref":"#/$defs/evidence"},"status":{"enum":["installed","runtimeObserved","notObserved"]}}
    },
    "scan": {
      "type":"object","additionalProperties":false,"required":["scanId","localUserId","batchIndex","batchCount","observationCount","failedSources","completed"],
      "properties": {
        "scanId":{"type":"string","pattern":"^[a-f0-9]{32}$"},"localUserId":{"type":"string","minLength":1,"maxLength":128},
        "batchIndex":{"type":"integer","minimum":0,"maximum":50},"batchCount":{"type":"integer","minimum":0,"maximum":50},
        "observationCount":{"type":"integer","minimum":0,"maximum":10000},"completed":{"type":"boolean"},
        "failedSources":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"}}
      }
    }
  }
}
