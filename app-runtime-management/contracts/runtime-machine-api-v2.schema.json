{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.local/contracts/app-runtime/runtime-machine-api-v2.schema.json",
  "title": "TimeOnChrome App Runtime machine protocol v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "segmentUpload", "terminalLogUpload"],
  "properties": {
    "policy": { "$ref": "#/$defs/policy" },
    "segmentUpload": { "$ref": "#/$defs/segmentUpload" },
    "terminalLogUpload": { "$ref": "#/$defs/terminalLogUpload" },
    "applicationCorrectionPage": { "$ref": "#/$defs/applicationCorrectionPage" }
  },
  "$defs": {
    "applicationCorrectionPage": {
      "type": "object", "additionalProperties": false,
      "required": ["cursor", "hasMore", "items"],
      "properties": {
        "cursor": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "hasMore": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["childId", "policyVersion", "fromMs", "toMs", "applications", "assignments"],
          "properties": {
            "childId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "policyVersion": { "type": "integer", "minimum": 1 },
            "fromMs": { "$ref": "runtime-app-policy-v1.schema.json#/properties/weekReclassification/properties/fromMs" },
            "toMs": { "$ref": "runtime-app-policy-v1.schema.json#/properties/weekReclassification/properties/toMs" },
            "applications": { "$ref": "runtime-app-policy-v1.schema.json#/properties/weekReclassification/properties/applications" },
            "assignments": { "type": "array", "maxItems": 20000, "items": {
              "type": "object", "additionalProperties": false, "required": ["localUserId", "assignmentVersion"],
              "properties": {
                "localUserId": { "$ref": "#/$defs/localUserId" },
                "assignmentVersion": { "type": "integer", "minimum": 1 }
              }
            } }
          }
        } }
      }
    },
    "localUserId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localUserId", "assignmentVersion", "childId", "protected"],
      "properties": {
        "localUserId": { "$ref": "#/$defs/localUserId" },
        "assignmentVersion": { "type": "integer", "minimum": 1 },
        "childId": { "type": ["string", "null"] },
        "protected": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "protected": { "const": false } } },
          "then": { "properties": { "childId": { "type": "null" } } }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "defaultChildId", "users"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "defaultChildId": { "type": ["string", "null"] },
        "users": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
        "appPolicies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["childId", "policy"],
            "properties": {
              "childId": { "type": "string", "minLength": 1 },
              "policy": { "$ref": "runtime-app-policy-v1.schema.json" }
            }
          }
        },
        "loggingPolicy": { "$ref": "#/$defs/loggingPolicy" }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "runtimeIdentity"],
      "properties": {
        "platform": { "enum": ["windows", "macos"] },
        "runtimeIdentity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "displayName": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "segmentEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localUserId", "assignmentVersion", "id", "runtimeSessionID", "application", "startAtMs", "endAtMs", "durationMilliseconds", "endReason"],
      "properties": {
        "localUserId": { "$ref": "#/$defs/localUserId" },
        "assignmentVersion": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "runtimeSessionID": { "type": "string", "minLength": 1, "maxLength": 200 },
        "application": { "$ref": "#/$defs/application" },
        "startAtMs": { "type": "integer", "minimum": 0 },
        "endAtMs": { "type": "integer", "minimum": 1 },
        "durationMilliseconds": { "type": "integer", "minimum": 1 },
        "endReason": { "enum": ["applicationSwitch", "userIdle", "sessionUnavailable", "systemSleep", "periodicSnapshot", "stateCorrection"] }
      }
    },
    "segmentUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "segments"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "segments": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/segmentEnvelope" } }
      }
    },
    "loggingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "enabled", "minLevel", "categories", "expiresAtMs"],
      "properties": {
        "version": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" },
        "minLevel": { "enum": ["info", "warning", "error"] },
        "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["service", "session", "policy", "upload", "storage", "security", "accounting"] } },
        "expiresAtMs": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "terminalLog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observedAtMs", "level", "category", "eventCode", "module", "messageCode", "details", "serviceVersion", "policyVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "observedAtMs": { "type": "integer", "minimum": 0 },
        "level": { "enum": ["info", "warning", "error"] },
        "category": { "enum": ["service", "session", "policy", "upload", "storage", "security", "accounting"] },
        "eventCode": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,96}$" },
        "module": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "messageCode": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,96}$" },
        "details": { "type": "object", "maxProperties": 12, "additionalProperties": { "type": ["boolean", "integer", "string"] } },
        "serviceVersion": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,32}$" },
        "policyVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "terminalLogUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logs"],
      "properties": { "logs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/terminalLog" } } }
    }
  }
}
