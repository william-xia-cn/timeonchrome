{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.app/contracts/shared-web-sync-v2.schema.json",
  "title": "D-114 可复用的共享来源身份；不授权执行",
  "$defs": {
    "hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "ms": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "scopeClaims": {
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","audience","applicationSourceKey","childScopeHash","assignmentVersion","issuedAtMs","expiresAtMs"],
      "properties": {
        "schemaVersion":{"const":2},"audience":{"const":"timeonchrome:shared-web-machine-scope:v2"},
        "applicationSourceKey":{"$ref":"#/$defs/hash"},"childScopeHash":{"$ref":"#/$defs/hash"},
        "assignmentVersion":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "issuedAtMs":{"$ref":"#/$defs/ms"},"expiresAtMs":{"$ref":"#/$defs/ms"}
      }
    },
    "webClaims": {
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","audience","applicationSourceKey","childScopeHash","assignmentVersion","issuedAtMs","expiresAtMs","webSourceKey","bindingEpochHash"],
      "properties": {
        "schemaVersion":{"const":2},"audience":{"const":"timeonchrome:shared-web-source:v2"},
        "applicationSourceKey":{"$ref":"#/$defs/hash"},"childScopeHash":{"$ref":"#/$defs/hash"},
        "assignmentVersion":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "issuedAtMs":{"$ref":"#/$defs/ms"},"expiresAtMs":{"$ref":"#/$defs/ms"},
        "webSourceKey":{"type":"string","pattern":"^web:[a-f0-9]{64}$"},"bindingEpochHash":{"$ref":"#/$defs/hash"}
      }
    },
    "scopeProof": {
      "type":"object","additionalProperties":false,"required":["schemaVersion","keyId","claims","signature"],
      "properties":{"schemaVersion":{"const":2},"keyId":{"$ref":"#/$defs/hash"},
        "claims":{"$ref":"#/$defs/scopeClaims"},"signature":{"type":"string","pattern":"^[A-Za-z0-9_-]{86}$"}}
    },
    "webProof": {
      "type":"object","additionalProperties":false,"required":["schemaVersion","keyId","claims","signature"],
      "properties":{"schemaVersion":{"const":2},"keyId":{"$ref":"#/$defs/hash"},
        "claims":{"$ref":"#/$defs/webClaims"},"signature":{"type":"string","pattern":"^[A-Za-z0-9_-]{86}$"}}
    },
    "bindQuery":{"type":"object","additionalProperties":false,"required":["proof"],"properties":{"proof":{"$ref":"#/$defs/webProof"}}},
    "replaceQuery":{"type":"object","additionalProperties":false,"required":["upload"],"properties":{"upload":{"$ref":"shared-web-sync-v1.schema.json#/$defs/upload"}}}
  }
}
