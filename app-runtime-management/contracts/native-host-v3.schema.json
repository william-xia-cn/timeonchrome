{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeonchrome.app/contracts/native-host-v3.schema.json",
  "title": "BrowserBridge v3 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "channel", "requestId", "messageType", "extensionId", "profileId", "sentAtMs", "payload"],
  "properties": {
    "protocolVersion": { "const": 3 },
    "channel": { "enum": ["health", "statistics", "application", "sharedQuota"] },
    "requestId": { "type": "string", "format": "uuid" },
    "messageType": { "enum": ["heartbeat", "probe", "dailyUsageSnapshot", "getApplicationUsage", "getSharedQuotaState", "reportReminderResult", "getSharedReminderState", "acknowledgeSharedReminderDelivery", "resolveSharedReminder", "reportBrowserActivity", "acknowledgeBrowserExecution", "getSharedWebSourceChallenge", "bindSharedWebSource", "replaceSharedWebContribution", "getSharedWebSourceScope", "bindSharedWebSourceV2", "replaceSharedWebContributionV2"] },
    "extensionId": { "type": "string", "minLength": 1 },
    "profileId": { "type": "string", "format": "uuid" },
    "sentAtMs": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "application" } }, "required": ["channel"] },
      "then": { "properties": { "messageType": { "const": "getApplicationUsage" }, "payload": { "$ref": "#/$defs/applicationQuery" } } }
    },
    {
      "if": { "properties": { "channel": { "const": "statistics" } }, "required": ["channel"] },
      "then": { "properties": { "messageType": { "const": "dailyUsageSnapshot" }, "payload": { "$ref": "#/$defs/dailySnapshot" } } }
    },
    {
      "if": { "properties": { "channel": { "const": "health" } }, "required": ["channel"] },
      "then": { "properties": { "messageType": { "enum": ["heartbeat", "probe"] } } }
    },
    {
      "if": { "properties": { "channel": { "const": "sharedQuota" } }, "required": ["channel"] },
      "then": {
        "properties": { "messageType": { "enum": ["getSharedQuotaState", "reportReminderResult", "getSharedReminderState", "acknowledgeSharedReminderDelivery", "resolveSharedReminder", "reportBrowserActivity", "acknowledgeBrowserExecution", "getSharedWebSourceChallenge", "bindSharedWebSource", "replaceSharedWebContribution", "getSharedWebSourceScope", "bindSharedWebSourceV2", "replaceSharedWebContributionV2"] } },
        "allOf": [
          { "if": { "properties": { "messageType": { "const": "getSharedQuotaState" } } },
            "then": { "properties": { "payload": { "$ref": "#/$defs/sharedQuotaQuery" } } } },
          { "if": { "properties": { "messageType": { "const": "reportReminderResult" } } },
            "then": { "properties": { "payload": { "$ref": "shared-access-v1.schema.json#/$defs/reminderResult" } } } },
          { "if": { "properties": { "messageType": { "const": "getSharedReminderState" } } },
            "then": { "properties": { "payload": { "$ref": "#/$defs/sharedQuotaQuery" } } } },
          { "if": { "properties": { "messageType": { "const": "acknowledgeSharedReminderDelivery" } } },
            "then": { "properties": { "payload": { "$ref": "shared-reminder-lifecycle-v1.schema.json#/$defs/deliveryAck" } } } },
          { "if": { "properties": { "messageType": { "const": "resolveSharedReminder" } } },
            "then": { "properties": { "payload": { "$ref": "shared-reminder-lifecycle-v1.schema.json#/$defs/resolution" } } } },
          { "if": { "properties": { "messageType": { "const": "reportBrowserActivity" } } },
            "then": { "properties": { "payload": { "$ref": "shared-reminder-lifecycle-v1.schema.json#/$defs/browserActivity" } } } },
          { "if": { "properties": { "messageType": { "const": "acknowledgeBrowserExecution" } } },
            "then": { "properties": { "payload": { "$ref": "shared-reminder-lifecycle-v1.schema.json#/$defs/browserExecutionAck" } } } },
          { "if": { "properties": { "messageType": { "const": "getSharedWebSourceScope" } } },
            "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 } } } },
          { "if": { "properties": { "messageType": { "const": "bindSharedWebSourceV2" } } },
            "then": { "properties": { "payload": { "$ref": "shared-web-sync-v2.schema.json#/$defs/bindQuery" } } } },
          { "if": { "properties": { "messageType": { "const": "replaceSharedWebContributionV2" } } },
            "then": { "properties": { "payload": { "$ref": "shared-web-sync-v2.schema.json#/$defs/replaceQuery" } } } },
          { "if": { "properties": { "messageType": { "const": "getSharedWebSourceChallenge" } } },
            "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 } } } },
          { "if": { "properties": { "messageType": { "const": "bindSharedWebSource" } } },
            "then": { "properties": { "payload": { "$ref": "shared-web-sync-v1.schema.json#/$defs/bindQuery" } } } },
          { "if": { "properties": { "messageType": { "const": "replaceSharedWebContribution" } } },
            "then": { "properties": { "payload": { "$ref": "shared-web-sync-v1.schema.json#/$defs/replaceQuery" } } } }
        ]
      }
    }
  ],
  "$defs": {
    "sharedQuotaQuery": {
      "type": "object", "additionalProperties": false, "required": ["date"],
      "properties": { "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } }
    },
    "applicationQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["fromDate", "toDate", "offset"],
      "properties": {
        "fromDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "toDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "expectedRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMs", "endMs", "creditedSeconds", "quotaBucket"],
      "properties": {
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 },
        "creditedSeconds": { "type": "integer", "minimum": 0 },
        "quotaBucket": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "dailySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "snapshotRevision", "statisticsRevision", "correctionRevision", "computedAtMs", "activeSeconds", "quotaBucketSeconds", "complete", "incompleteReasonCodes", "intervals"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "snapshotRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "statisticsRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correctionRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "computedAtMs": { "type": "integer", "minimum": 0 },
        "activeSeconds": { "type": "integer", "minimum": 0 },
        "quotaBucketSeconds": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "complete": { "type": "boolean" },
        "incompleteReasonCodes": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "uniqueItems": true },
        "intervals": { "type": "array", "items": { "$ref": "#/$defs/evidenceInterval" }, "maxItems": 2000 }
      }
    }
  }
}
